DATABASE_URL=postgresql://localhost:5432/tutor-court
PAYLOAD_SECRET=generate_with_openssl_rand_hex_32
NEXT_PUBLIC_SERVER_URL=http://localhost:5021

### Tigris (S3-compatible storage)
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
TIGRIS_STORAGE_BUCKET=tutor-court

### Email (ZeptoMail)
ZEPTO_MAIL_API_KEY=
ZEPTO_MAIL_FROM=noreply@example.com
ZEPTO_MAIL_FROM_NAME=Tutor Court

### Paystack (wallet funding)
PAYSTACK_SECRET_KEY=

### Cloudflare TURN (NAT traversal for live classes)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Cron auth (Bearer). Generate with: openssl rand -hex 32
CRON_SECRET=
# Public HTTPS base URL the scheduler should hit (defaults to NEXT_PUBLIC_SERVER_URL).
# Required for `pnpm setup:crons` — QStash cannot reach localhost.
CRON_TARGET_BASE_URL=
# OPTIONAL — Upstash QStash to schedule crons. Only needed for `pnpm setup:crons`.
QSTASH_TOKEN=
