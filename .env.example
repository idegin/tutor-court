# Here are the admin credentials generated:
# Email: admin@tutorcourt.com
# Password: password123

# ── Live Classroom v2 (realtime) ─────────────────────────────────────────
# Cloudflare TURN (NAT traversal) — server-only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Cloudflare Realtime (Calls) SFU — server-only.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

ABLY_API_KEY=


# Live Classroom v2 — Phase 6 billing cron reuses CRON_SECRET (Bearer).
# Optional durable rate limiting / scheduling via Upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=

# ── Scheduled jobs (escrow auto-release + live-session sweep) ─────────────
# Bearer token every cron route checks. Must ALSO be set in the deploy platform's
# env (e.g. the Vercel project), not just here. On Vercel, setting CRON_SECRET
# makes Vercel Cron auto-send `Authorization: Bearer $CRON_SECRET`.
#
# Three scheduled jobs exist:
#   - /api/cron/complete-engagements  (daily)      — escrow auto-release
#   - /api/cron/live-sweep            (every 3 min) — end abandoned sessions
#   - /api/cron/process-payouts       (every 5 min) — SEND tutor bank transfers
#     via Paystack + reconcile them. Tutor withdrawals stay stuck in
#     'processing' until this runs, so it MUST be scheduled.
# Pick ONE scheduler per job so nothing double-fires:
#   - Vercel Hobby: vercel.json runs complete-engagements daily. Schedule the two
#     sub-daily jobs (live-sweep, process-payouts) via QStash — Hobby can't run
#     sub-daily crons. Do NOT also register complete-engagements in QStash.
#   - Vercel Pro: you may move all three to vercel.json.
#   - Any other host: run `pnpm setup:crons` (uses QSTASH_TOKEN) to register ALL
#     THREE via QStash, and don't rely on vercel.json.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Public HTTPS base URL the scheduler should hit (defaults to NEXT_PUBLIC_SERVER_URL).
# Required for `pnpm setup:crons` — QStash cannot reach localhost.
CRON_TARGET_BASE_URL=
